---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Expediente Desclasificado: Cristobal Antonio Rojas Perez - Analista de Datos / Business Intelligence" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Google Fonts: Courier Prime for typewriter feel -->
    <link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="animate-flicker min-h-screen relative font-typewriter">
    <div class="crt-overlay"></div>
    <main class="relative z-10 max-w-6xl mx-auto p-4 sm:p-6 lg:p-8">
      <slot />
    </main>
  </body>
</html>
